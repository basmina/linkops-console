# LinkOps Console - environment variables
#
# The application runs with zero configuration. Every variable below is
# optional and has a working default. Copy this file to `.env` only if you
# need to override one of them:
#
#   cp .env.example .env
#
# There are no secrets or credentials in this project. Nothing here is
# required for `npm start`, `npm test`, or `npm run build` to work.

# Port the NestJS API listens on.
# Optional. Default: 3000
PORT=3000

# Node environment. When set to "production" the Swagger UI at /api/docs
# is not mounted.
# Optional. Default: (unset, treated as development)
NODE_ENV=development
